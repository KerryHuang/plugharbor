{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'PY=$(command -v python3 || command -v python); exec \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-model-guard.py\"'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
